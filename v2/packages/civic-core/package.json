{
  "name": "@v2/civic-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Vocabulario de la ubicación y lógica territorial compartida entre la web y la app de campo. Lógica pura, sin dependencias.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "echo 'no integration tests' && exit 0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@v2/config-eslint": "workspace:*",
    "@v2/config-typescript": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
