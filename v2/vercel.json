{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build && pnpm api:bundle",
  "outputDirectory": "apps/web/dist",
  "redirects": [
    { "source": "/recursos/guias-estudio/:curso/leccion/:leccion", "destination": "/entrenamientos/:curso/leccion/:leccion", "permanent": true },
    { "source": "/recursos/guias-estudio/:curso/quiz", "destination": "/entrenamientos/:curso/practica", "permanent": true },
    { "source": "/recursos/guias-estudio/:slug", "destination": "/entrenamientos/:slug", "permanent": true },
    { "source": "/recursos/guias-estudio", "destination": "/entrenamientos", "permanent": true },
    { "source": "/recursos/ensayos/:slug", "destination": "/ensayos/:slug", "permanent": true },
    { "source": "/recursos/ensayos", "destination": "/ensayos", "permanent": true },
    { "source": "/recursos/blog/:slug", "destination": "/blog/:slug", "permanent": true },
    { "source": "/recursos/blog", "destination": "/blog", "permanent": true },
    { "source": "/recursos/vlog/:slug", "destination": "/blog/:slug", "permanent": true },
    { "source": "/recursos/vlog", "destination": "/blog", "permanent": true },
    { "source": "/recursos/ruta/iniciativas/:slug/documento", "destination": "/iniciativas/:slug/documento", "permanent": true },
    { "source": "/recursos/ruta/iniciativas/:slug", "destination": "/iniciativas/:slug", "permanent": true },
    { "source": "/recursos/ruta", "destination": "/una-ruta-para-argentina", "permanent": true },
    { "source": "/recursos/iniciativas/:slug/documento", "destination": "/iniciativas/:slug/documento", "permanent": true },
    { "source": "/recursos/iniciativas/:slug", "destination": "/iniciativas/:slug", "permanent": true },
    { "source": "/recursos/iniciativas", "destination": "/planes", "permanent": true },
    { "source": "/recursos/el-arquitecto", "destination": "/auto-evaluacion-civica", "permanent": true },
    { "source": "/recursos", "destination": "/biblioteca", "permanent": true },
    { "source": "/blog-vlog/:slug", "destination": "/blog/:slug", "permanent": true },
    { "source": "/blog-vlog", "destination": "/blog", "permanent": true },
    { "source": "/resources/:id", "destination": "/biblioteca", "permanent": true },
    { "source": "/login", "destination": "/ingresar", "permanent": true },
    { "source": "/register", "destination": "/registrarse", "permanent": true },
    { "source": "/dashboard-legacy", "destination": "/tablero", "permanent": true },
    { "source": "/dashboard", "destination": "/tablero", "permanent": true },
    { "source": "/profile", "destination": "/mi-perfil", "permanent": true },
    { "source": "/metas", "destination": "/objetivos", "permanent": true },
    { "source": "/evaluacion", "destination": "/auto-evaluacion-civica", "permanent": true },
    { "source": "/checkin-semanal", "destination": "/check-in-semanal", "permanent": true },
    { "source": "/life-areas/:area/quiz", "destination": "/areas", "permanent": true },
    { "source": "/life-areas/:area", "destination": "/areas", "permanent": true },
    { "source": "/life-areas", "destination": "/areas", "permanent": true },
    { "source": "/challenges/:id", "destination": "/desafios", "permanent": true },
    { "source": "/challenges", "destination": "/desafios", "permanent": true },
    { "source": "/mision/:slug", "destination": "/desafios", "permanent": true },
    { "source": "/community/:resto*", "destination": "/comunidad", "permanent": true },
    { "source": "/community", "destination": "/comunidad", "permanent": true },
    { "source": "/circulos", "destination": "/comunidad", "permanent": true },
    { "source": "/u/:username", "destination": "/comunidad", "permanent": true },
    { "source": "/el-mandato-vivo", "destination": "/mandato-vivo", "permanent": true },
    { "source": "/mandato/propuesta/:id", "destination": "/mandato-vivo/propuesta/:id", "permanent": true },
    { "source": "/mandato/pulso/:id", "destination": "/mandato-vivo/pulso/:id", "permanent": true },
    { "source": "/propuesta/:id", "destination": "/mandato-vivo/propuesta/:id", "permanent": true },
    { "source": "/pulso/:id", "destination": "/mandato-vivo/pulso/:id", "permanent": true },
    { "source": "/mandato-publico/:level/:name", "destination": "/mandato-vivo", "permanent": true },
    { "source": "/mandato/:level/:name", "destination": "/mandato-vivo", "permanent": true },
    { "source": "/el-pulso", "destination": "/mandato-vivo", "permanent": true },
    { "source": "/radar", "destination": "/el-mapa", "permanent": true },
    { "source": "/apoya-al-movimiento", "destination": "/apoyo", "permanent": true },
    { "source": "/feedback", "destination": "/comunidad", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/((?!cron/).*)", "destination": "/api/index?__ruta=$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/cron/rankings.mjs": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/cron/rankings", "schedule": "0 5 * * *" }]
}
