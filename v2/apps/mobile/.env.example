# API HTTPS del sitio/plataforma que contiene la API cívica v1.
# En un teléfono físico no uses localhost: elegí la URL desplegada o la IP LAN.
EXPO_PUBLIC_CIVIC_API_URL=http://localhost:5000

# Origen de la API de v2 (la plataforma web: /api/auth, /api/v1/contribuciones,
# /api/v1/mi-espacio). Lo usa el recorrido de Argentina ideal (Imaginar y Mi
# espacio); sin este valor esas pantallas funcionan sólo en el dispositivo, sin
# enviar ni ingresar. En local es la API de v2 (`pnpm --filter @v2/api dev`),
# que escucha en el puerto 4000 (API_PORT en v2/env.example). HTTP sólo se
# acepta hacia localhost en desarrollo: en un teléfono físico o en un build usá
# la URL HTTPS desplegada.
EXPO_PUBLIC_BASTA_V2_URL=http://localhost:4000
