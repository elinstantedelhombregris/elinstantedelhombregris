{
  "version": 8,
  "name": "Papel y Tinta",
  "metadata": {
    "descripcion": "Basemap del sistema Papel y Tinta sobre teselas vectoriales de Carto (esquema OpenMapTiles). Prototipo para comparar contra el lienzo SVG precomputado — ver docs/specs/2026-07-26-mapa-1-el-lienzo.md.",
    "criterio": "El mapa es papel: fondo crudo, trazos de tinta, cero saturación. Las únicas cosas que llevan color son las señales que se dibujan encima, y por eso el fondo no puede competir. Se apagan POIs, comercios y numeración de casas: son ruido de mapa de navegación, no de mapa cívico.",
    "atribucion": "© OpenStreetMap contributors, © CARTO"
  },
  "glyphs": "https://tiles.basemaps.cartocdn.com/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "carto": {
      "type": "vector",
      "url": "https://tiles.basemaps.cartocdn.com/vector/carto.streets/v1/tiles.json",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> · © <a href=\"https://carto.com/attributions\">CARTO</a>"
    }
  },
  "layers": [
    {
      "id": "fondo",
      "type": "background",
      "paint": { "background-color": "#F2EFE7" }
    },
    {
      "id": "verde",
      "type": "fill",
      "source": "carto",
      "source-layer": "park",
      "paint": { "fill-color": "#E4E0D3", "fill-opacity": 0.55 }
    },
    {
      "id": "urbano",
      "type": "fill",
      "source": "carto",
      "source-layer": "landuse",
      "filter": ["match", ["get", "class"], ["residential", "suburb", "neighbourhood"], true, false],
      "paint": { "fill-color": "#ECE8DC", "fill-opacity": 0.7 }
    },
    {
      "id": "agua",
      "type": "fill",
      "source": "carto",
      "source-layer": "water",
      "paint": { "fill-color": "#D8D4C8" }
    },
    {
      "id": "rio",
      "type": "line",
      "source": "carto",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#B5B1A8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.4, 14, 1.4]
      }
    },
    {
      "id": "manzanas",
      "type": "fill",
      "source": "carto",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#D8D4C8",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 14, 0, 16, 0.5]
      }
    },
    {
      "id": "calles-menores",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["match", ["get", "class"], ["minor", "service", "path", "track"], true, false],
      "paint": {
        "line-color": "#B5B1A8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.3, 17, 2]
      }
    },
    {
      "id": "calles",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": ["match", ["get", "class"], ["secondary", "tertiary"], true, false],
      "paint": {
        "line-color": "#7A756A",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.4, 17, 3]
      }
    },
    {
      "id": "rutas",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary"], true, false],
      "paint": {
        "line-color": "#4A463D",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.5, 10, 1.6, 17, 4]
      }
    },
    {
      "id": "vias",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["==", ["get", "class"], "rail"],
      "paint": {
        "line-color": "#B5B1A8",
        "line-width": 0.8,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "limites",
      "type": "line",
      "source": "carto",
      "source-layer": "boundary",
      "filter": ["<=", ["get", "admin_level"], 4],
      "paint": {
        "line-color": "#7A756A",
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.6, 10, 1.4],
        "line-dasharray": [4, 2]
      }
    },
    {
      "id": "nombres-agua",
      "type": "symbol",
      "source": "carto",
      "source-layer": "water_name",
      "minzoom": 7,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Inter Italic"],
        "text-size": 11,
        "text-max-width": 6
      },
      "paint": { "text-color": "#7A756A", "text-halo-color": "#F2EFE7", "text-halo-width": 1.2 }
    },
    {
      "id": "localidades",
      "type": "symbol",
      "source": "carto",
      "source-layer": "place",
      "filter": ["match", ["get", "class"], ["city", "town", "village"], true, false],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Inter Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 10, 12, 14],
        "text-max-width": 8,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.08
      },
      "paint": { "text-color": "#4A463D", "text-halo-color": "#F2EFE7", "text-halo-width": 1.5 }
    },
    {
      "id": "calles-nombres",
      "type": "symbol",
      "source": "carto",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Inter Regular"],
        "text-size": 10,
        "symbol-placement": "line"
      },
      "paint": { "text-color": "#7A756A", "text-halo-color": "#F2EFE7", "text-halo-width": 1.2 }
    }
  ]
}
