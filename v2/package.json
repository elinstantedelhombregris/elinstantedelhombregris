{
  "name": "el-instante-del-hombre-gris",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "El Instante del Hombre Gris — Argentine civic engagement platform built around the ¡BASTA! popular governance framework. v2 rebuild.",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r --filter './apps/*' --filter './packages/*' build",
    "lint": "pnpm -r --parallel lint && pnpm lint:scripts",
    "lint:fix": "pnpm -r --parallel lint:fix && eslint scripts --fix",
    "lint:scripts": "eslint scripts --max-warnings 0",
    "type-check": "pnpm -r --parallel type-check && pnpm type-check:scripts",
    "type-check:scripts": "tsc -p scripts/tsconfig.json",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,css,yml,yaml}\"",
    "test": "pnpm test:unit && pnpm test:scripts && pnpm test:integration",
    "test:unit": "pnpm -r --parallel test:unit",
    "test:integration": "pnpm -r --parallel test:integration",
    "test:e2e": "playwright test",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "api:bundle": "tsx scripts/build/bundle-api.ts",
    "planes:migrar": "tsx scripts/content/migrate-planes-v1-to-v2.ts",
    "geo:provincias": "tsx scripts/build/geo/generar-provincias-api.ts",
    "mapa:estilo": "tsx scripts/build/mapa/generar-estilo.ts",
    "csp:generar": "tsx scripts/build/seguridad/generar-csp-vercel.ts",
    "tipografias:bajar": "tsx scripts/build/tipografias/bajar-tipografias.ts",
    "geo:backfill": "pnpm --filter @v2/api run geo:backfill",
    "planes:check": "tsx scripts/content/verify-planes-index.ts",
    "entrenamientos:reporte": "tsx scripts/content/entrenamientos-reporte.ts",
    "entrenamientos:voseo": "tsx scripts/content/entrenamientos-voseo.ts",
    "entrenamientos:borrar-cola": "tsx scripts/content/entrenamientos-borrar-cola.ts",
    "deudas:importar": "tsx scripts/content/importar-deudas.ts",
    "radiografia:embeber": "tsx scripts/radiografia/embeber.ts",
    "simulacion:calibrar": "tsx scripts/simulacion/calibrar.ts",
    "simulacion:elenco": "tsx scripts/simulacion/elenco-ollama.ts",
    "deps:check": "tsx scripts/build/deps-check.ts",
    "size": "size-limit",
    "verify": "pnpm lint && pnpm type-check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@maplibre/maplibre-gl-style-spec": "^20.4.0",
    "@playwright/test": "^1.49.0",
    "@size-limit/preset-app": "^11.1.6",
    "@types/node": "^22.10.2",
    "@v2/config-eslint": "workspace:*",
    "@v2/db": "workspace:*",
    "@v2/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "esbuild": "^0.28.1",
    "eslint": "^9.17.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "protomaps-themes-base": "^4.5.0",
    "size-limit": "^11.1.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "eslint": "^9.17.0"
    },
    "patchedDependencies": {
      "expo-sqlite@57.0.0": "patches/expo-sqlite@57.0.0.patch"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ],
    "packageExtensions": {
      "wouter": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "lucide-react": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "recharts": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "react-map-gl": {
        "peerDependencies": {
          "@types/react": "*"
        }
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
