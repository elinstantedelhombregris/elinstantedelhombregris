# =============================================================================
# v2 environment template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_PORT=5173
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Database (Neon Postgres)
# -----------------------------------------------------------------------------
# Production / dev pooled connection
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Direct (non-pooled) connection — required for migrations
DATABASE_URL_UNPOOLED=postgres://user:password@host/db?sslmode=require

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# 64+ random hex characters; rotate on incident
JWT_SECRET=change-me-to-a-long-random-hex-string
SESSION_SECRET=change-me-to-a-different-long-random-hex-string
# Cookie domain (e.g. .elinstantedelhombregris.com); leave blank for localhost
COOKIE_DOMAIN=
COOKIE_SECURE=false   # true in production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5273

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
# Faltas que /lo-que-falta acepta por hora y por IP. Es el único canal que
# publica al instante y sin revisión previa, así que su techo se ajusta sin
# desplegar (spec 2026-08-12-lo-que-falta.md §2.6).
FALTAS_POR_HORA=6

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=hola@elinstantedelhombregris.com

# -----------------------------------------------------------------------------
# AI
# -----------------------------------------------------------------------------
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Embeddings de La Radiografía — Ollama LOCAL
# -----------------------------------------------------------------------------
# El texto que escribe la gente NO se manda a Groq ni a ningún proveedor
# externo. Nunca. Los vectores de convergencia los calcula un Ollama corriendo
# en la máquina, y por eso la tabla de transferencias de la política de
# privacidad no se ensancha ni una coma.
#
# Estas variables sólo las lee `pnpm radiografia:embeber`, que se corre a mano y
# fuera de banda. La API no las necesita y Vercel no las tiene que tener.
#
# Para que ande:   ollama serve   ·   ollama pull bge-m3
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELO=bge-m3
# Si Ollama corre en OTRA máquina, hay que nombrar el host acá además de en
# OLLAMA_URL. El texto que escribe la gente viaja en el cuerpo de cada pedido,
# y esta plataforma decidió que eso no pase por un descuido de variable de
# entorno (ADR 0009). Vacío = Ollama local, que es lo normal.
OLLAMA_HOST_REMOTO=
# Las de bge-m3. Si cambiás de modelo, cambiá esto: un vector de otro largo no
# se puede comparar con los que ya están guardados, y la base lo rechaza.
OLLAMA_DIMENSIONES=1024

# -----------------------------------------------------------------------------
# Crons (Vercel)
# -----------------------------------------------------------------------------
# Vercel manda `Authorization: Bearer $CRON_SECRET` en cada invocación agendada.
# Sin este valor el handler devuelve 401 y no toca la base: un endpoint que
# recalcula rankings abierto al internet es un DoS gratis. Ver ADR 0008 D3.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# Comma-separated usernames allowed to use admin-only endpoints
# (currently: blog post creation/edit). Leave blank for no admins.
ADMIN_USERNAMES=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info   # debug | info | warn | error
