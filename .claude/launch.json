{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "v2-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "cd v2/apps/web && pnpm dev --port \"${PORT:-5273}\""
      ],
      "port": 5273,
      "autoPort": true
    },
    {
      "name": "v2-api",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "cd v2/apps/api && pnpm dev"
      ],
      "port": 4000
    },
    {
      "name": "socialjusticehub-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "cd SocialJusticeHub && npm run dev"
      ],
      "port": 3001
    },
    {
      "name": "basta-juego-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "cd v2/apps/mobile && npx expo start --web --port \"$PORT\""
      ],
      "port": 8082,
      "autoPort": true
    }
  ]
}
