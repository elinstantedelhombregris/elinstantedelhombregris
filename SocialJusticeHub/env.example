# Database Configuration
DATABASE_URL=./local.db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Civic mobile device credentials. Use a different random 32+ char value in production.
CIVIC_DEVICE_PEPPER=replace-with-an-independent-random-secret-min-32-chars
CIVIC_DEVICE_TOKEN_TTL_SECONDS=604800
# Never lower below 5: small territorial groups are removed from public aggregates.
CIVIC_AGGREGATE_MIN_ACTORS=5

# Production safety gates
#
# KEEP ALL FALSE in normal operation. These deliberately loud escape hatches
# accept only the exact string `true` and require an explicit privacy and
# governance review before use.
#
# When false, legacy row-level public endpoints return 503 JSON pointing to
# GET /api/v1/civic/aggregates. Development and test remain open regardless.
DANGEROUSLY_ALLOW_LEGACY_RAW_PUBLIC_DATA_IN_PRODUCTION=false
# The legacy engine reads row-level testimony. Keep it off; the supported
# replacement is GET /api/v1/civic/intelligence over protected aggregates.
DANGEROUSLY_ENABLE_LEGACY_AI_MANDATE_ENGINE=false
# This second gate can only start the cron when the engine gate is also true.
DANGEROUSLY_ENABLE_AUTOMATIC_AI_MANDATE_CRON=false

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:8082
CORS_CREDENTIALS=true

# Environment
NODE_ENV=development
PORT=5000
ENABLE_NLP_MODELS=false

# Session Configuration
SESSION_SECRET=your-session-secret-key-change-in-production
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_MAX_AGE=86400000
